NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGINS=*
SWAGGER_ENABLED=true

# Runtime connection. For managed pools (Neon) use the pooler host and keep a
# hard per-client connection cap + generous pool timeout so cold starts never
# fail the first transaction:
#   DATABASE_URL=postgresql://user:pass@<host>-pooler.../neondb?sslmode=require&connection_limit=5&pool_timeout=15
DATABASE_URL=postgresql://erp:erp_dev@localhost:5432/erp_dev

# CLI / migrations use the DIRECT (non-pooler) endpoint so pg_advisory_locks
# and transaction-scoped GUCs behave. Prisma reads directUrl from the schema.
# The API runtime does NOT need this var.
DIRECT_URL=postgresql://erp:erp_dev@localhost:5432/erp_dev
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-dev
JWT_REFRESH_EXPIRES_IN=7d

# Object storage (G-3). STORAGE_DRIVER selects the driver: `local` writes under
# STORAGE_LOCAL_DIR (defaults to ./storage); `s3` uses the S3-compatible client
# below and REQUIRES STORAGE_ACCESS_KEY + STORAGE_SECRET_KEY.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_ENDPOINT=localhost
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=erp-dev
STORAGE_REGION=us-east-1