// Multi-tenant ERP — platform foundation schema
// Conventions (plan §11): UUID PKs, tenant_id on every owned table,
// created_at/updated_at TIMESTAMPTZ, constraint-heavy.
// RLS policies are applied as raw SQL migration steps (not expressible in schema).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Prisma CLI/migrations use the direct Neon endpoint; runtime uses the pooler.
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  INACTIVE
}

// Keep portable for the sSaaS scale-out path (plan §7): strongly typed
// tenant_id filters, UUID keys everywhere.
model Tenant {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String       @unique @db.VarChar(63)
  status    TenantStatus @default(TRIAL)
  timezone  String       @default("UTC") @db.VarChar(64)
  currency  String       @default("USD") @db.VarChar(3)
  country   String?      @db.VarChar(2)
  language  String       @default("en") @db.VarChar(8)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  users             TenantUser[]
  roles             Role[]
  permissions       RolePermission[]
  userRoles         UserRole[]
  sessions          Session[]
  auditLogs         AuditLog[]
  sequences         DocumentSequence[]
  subscriptions     Subscription[]
  idempotencyKeys   IdempotencyKey[]
  companies         Company[]
  branches          Branch[]
  tenantSettings    TenantSetting[]
  customers         Customer[]
  customerContacts  CustomerContact[]
  units             Unit[]
  productCategories ProductCategory[]
  products          Product[]
  taxRates          TaxRate[]
  documentFiles     DocumentFile[]

  quotations         Quotation[]
  quotationItems     QuotationItem[]
  salesOrders        SalesOrder[]
  salesOrderItems    SalesOrderItem[]
  deliveries         Delivery[]
  deliveryItems      DeliveryItem[]
  invoices           Invoice[]
  invoiceItems       InvoiceItem[]
  payments           Payment[]
  paymentAllocations PaymentAllocation[]
  bankAccounts       BankAccount[]
  warehouses         Warehouse[]
  stockBalances      StockBalance[]
  stockMovements     StockMovement[]
  batches            Batch[]
  serials            SerialNumber[]
  accountGroups      AccountGroup[]
  accounts           Account[]
  journalEntries     JournalEntry[]
  journalEntryLines  JournalEntryLine[]
  fiscalPeriods      FiscalPeriod[]
  bankTransactions   BankTransaction[]

  @@index([status])
  @@map("tenants")
}

model TenantUser {
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @map("tenant_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id])
  userId   String @map("user_id") @db.Uuid
  status   String @default("ACTIVE")

  @@id([tenantId, userId])
  @@index([userId])
  @@map("tenant_users")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(255)
  status       String    @default("ACTIVE")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenants   TenantUser[]
  userRoles UserRole[]
  sessions  Session[]
  auditLogs AuditLog[]

  @@index([email])
  @@map("users")
}

// ---------------------------------------------------------------------------
// RBAC (plan §9) — permission codes, tenant-scoped roles.
// ---------------------------------------------------------------------------

model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String   @db.VarChar(100)
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String @unique @db.VarChar(120) // e.g. sales.quote.approve
  description String @db.VarChar(255)
  group       String @db.VarChar(60)

  roles RolePermission[]

  @@index([group])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  tenant       Tenant     @relation(fields: [tenantId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId   String @map("user_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id])
  role     Role   @relation(fields: [roleId], references: [id])
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Sessions (plan §24) — rotated refresh tokens stored as hashes.
// ---------------------------------------------------------------------------

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model Session {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  refreshTokenHash String        @unique @map("refresh_token_hash") @db.VarChar(128)
  familyId         String        @map("family_id") @db.Uuid
  device           Json?
  status           SessionStatus @default(ACTIVE)
  lastUsedAt       DateTime?     @map("last_used_at") @db.Timestamptz(6)
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([familyId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Idempotency (plan §16a) — PG table is the source of truth for correctness.
// ---------------------------------------------------------------------------

enum IdempotencyStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

model IdempotencyKey {
  key          String            @db.VarChar(64)
  endpoint     String            @db.VarChar(255)
  userId       String            @map("user_id") @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  requestHash  String            @map("request_hash") @db.VarChar(64)
  status       IdempotencyStatus @default(PENDING)
  responseCode Int?              @map("response_code")
  responseBody Json?
  lockedAt     DateTime?         @map("locked_at") @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt   DateTime?         @map("finished_at") @db.Timestamptz(6)
  expiresAt    DateTime          @map("expires_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([key, endpoint, userId])
  @@index([tenantId])
  @@index([lockedAt, status])
  @@index([expiresAt, status])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Document numbering (plan §12) — tenant + document_type + financial_year.
// ---------------------------------------------------------------------------

model DocumentSequence {
  tenantId      String   @map("tenant_id") @db.Uuid
  documentType  String   @map("document_type") @db.VarChar(32)
  financialYear Int      @map("financial_year")
  prefix        String   @db.VarChar(20)
  nextNumber    BigInt   @default(1) @map("next_number")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, documentType, financialYear])
  @@map("document_sequences")
}

// ---------------------------------------------------------------------------
// Audit log (plan §21) — centralized backend instrumentation.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String   @map("entity_id") @db.VarChar(64)
  oldValues  Json?
  newValues  Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Organization (plan §10) — built in Phase 1 with the foundation.
// ---------------------------------------------------------------------------

model Company {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String   @db.VarChar(255)
  legalName String?  @map("legal_name") @db.VarChar(255)
  taxId     String?  @map("tax_id") @db.VarChar(64)
  email     String?  @db.VarChar(255)
  phone     String?  @db.VarChar(32)
  country   String?  @db.VarChar(2)
  currency  String   @default("USD") @db.VarChar(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branches Branch[]

  @@index([tenantId])
  @@map("companies")
}

model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(255)
  code      String?  @db.VarChar(32)
  address   Json?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  quotations  Quotation[]
  salesOrders SalesOrder[]
  warehouses  Warehouse[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// CRM — Phase 2 (plan §CRM)
// ---------------------------------------------------------------------------

model Customer {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  code     String? @db.VarChar(32)
  name     String  @db.VarChar(255)
  email    String? @db.VarChar(255)
  phone    String? @db.VarChar(32)
  website  String? @db.VarChar(255)
  taxId    String? @map("tax_id") @db.VarChar(64)
  currency String  @default("USD") @db.VarChar(3)
  address  Json?
  notes    String? @db.Text
  isActive Boolean @default(true) @map("is_active")

  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  contacts    CustomerContact[]
  quotations  Quotation[]
  salesOrders SalesOrder[]
  invoices    Invoice[]
  payments    Payment[]

  @@index([tenantId, isActive])
  @@map("customers")
}

model CustomerContact {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String   @db.VarChar(255)
  title      String?  @db.VarChar(100)
  email      String?  @db.VarChar(255)
  phone      String?  @db.VarChar(32)
  isPrimary  Boolean  @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([customerId])
  @@index([tenantId])
  @@map("customer_contacts")
}

// ---------------------------------------------------------------------------
// Master data / inventory — Phase 2 (plan §Inventory)
// ---------------------------------------------------------------------------

model Unit {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String   @db.VarChar(100)
  code         String   @db.VarChar(16)
  symbol       String?  @db.VarChar(16)
  baseUnitId   String?  @map("base_unit_id") @db.Uuid
  baseUnit     Unit?    @relation("UnitConversion", fields: [baseUnitId], references: [id])
  derivedUnits Unit[]   @relation("UnitConversion")
  factorToBase Decimal? @map("factor_to_base") @db.Decimal(18, 6)
  isActive     Boolean  @default(true) @map("is_active")

  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  products        Product[]
  quotationItems  QuotationItem[]
  salesOrderItems SalesOrderItem[]
  deliveryItems   DeliveryItem[]
  invoiceItems    InvoiceItem[]

  @@unique([tenantId, code])
  @@map("units")
}

model ProductCategory {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  parentId    String?           @map("parent_id") @db.Uuid
  parent      ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("CategoryTree")
  name        String            @db.VarChar(255)
  code        String?           @db.VarChar(32)
  description String?           @db.Text
  isActive    Boolean           @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  products  Product[]

  @@index([tenantId, isActive])
  @@map("product_categories")
}

model Product {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  categoryId  String?          @map("category_id") @db.Uuid
  category    ProductCategory? @relation(fields: [categoryId], references: [id])
  unitId      String?          @map("unit_id") @db.Uuid
  unit        Unit?            @relation(fields: [unitId], references: [id])
  taxRateId   String?          @map("tax_rate_id") @db.Uuid
  taxRate     TaxRate?         @relation(fields: [taxRateId], references: [id])
  type        ProductType      @default(GOOD)
  name        String           @db.VarChar(255)
  sku         String           @db.VarChar(64)
  barcode     String?          @db.VarChar(64)
  description String?          @db.Text
  costPrice   Decimal?         @map("cost_price") @db.Decimal(18, 4)
  salePrice   Decimal?         @map("sale_price") @db.Decimal(18, 4)
  isActive    Boolean          @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  quotationItems  QuotationItem[]
  salesOrderItems SalesOrderItem[]
  deliveryItems   DeliveryItem[]
  invoiceItems    InvoiceItem[]
  stockBalances   StockBalance[]
  stockMovements  StockMovement[]
  batches         Batch[]
  serials         SerialNumber[]

  @@unique([tenantId, sku])
  @@index([tenantId, name])
  @@map("products")
}

enum ProductType {
  GOOD
  SERVICE
}

model TaxRate {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  name        String  @db.VarChar(100)
  code        String  @db.VarChar(20)
  rate        Decimal @db.Decimal(5, 2)
  isInclusive Boolean @default(false) @map("is_inclusive")
  isActive    Boolean @default(true) @map("is_active")

  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  products        Product[]
  quotationItems  QuotationItem[]
  salesOrderItems SalesOrderItem[]
  invoiceItems    InvoiceItem[]

  @@unique([tenantId, code])
  @@map("tax_rates")
}

// ---------------------------------------------------------------------------
// Sales — Phase 3 (plan §13). State machines, document numbering at post.
// ---------------------------------------------------------------------------

model Quotation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  number        String?   @db.VarChar(32)
  customerId    String    @map("customer_id") @db.Uuid
  customer      Customer  @relation(fields: [customerId], references: [id])
  branchId      String?   @map("branch_id") @db.Uuid
  branch        Branch?   @relation(fields: [branchId], references: [id])
  status        String    @default("DRAFT") @db.VarChar(16)
  currency      String    @default("USD") @db.VarChar(3)
  validUntil    DateTime? @map("valid_until") @db.Timestamptz(6)
  subtotal      Decimal   @default(0) @db.Decimal(18, 4)
  discountTotal Decimal   @default(0) @map("discount_total") @db.Decimal(18, 4)
  taxTotal      Decimal   @default(0) @map("tax_total") @db.Decimal(18, 4)
  total         Decimal   @default(0) @db.Decimal(18, 4)
  notes         String?   @db.Text
  createdById   String?   @map("created_by_id") @db.Uuid
  approvedById  String?   @map("approved_by_id") @db.Uuid
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(6)
  mobileUuid    String?   @unique @map("mobile_uuid") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  items  QuotationItem[]
  orders SalesOrder[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  quotationId String    @map("quotation_id") @db.Uuid
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String?   @map("product_id") @db.Uuid
  product     Product?  @relation(fields: [productId], references: [id])
  description String    @db.Text
  quantity    Decimal   @db.Decimal(18, 4)
  unitId      String?   @map("unit_id") @db.Uuid
  unit        Unit?     @relation(fields: [unitId], references: [id])
  unitPrice   Decimal   @map("unit_price") @db.Decimal(18, 4)
  discountPct Decimal   @default(0) @map("discount_pct") @db.Decimal(5, 2)
  discountAmt Decimal   @default(0) @map("discount_amt") @db.Decimal(18, 4)
  taxRateId   String?   @map("tax_rate_id") @db.Uuid
  taxRate     TaxRate?  @relation(fields: [taxRateId], references: [id])
  taxAmount   Decimal   @default(0) @map("tax_amount") @db.Decimal(18, 4)
  lineTotal   Decimal   @default(0) @map("line_total") @db.Decimal(18, 4)
  sortOrder   Int       @default(0) @map("sort_order")

  @@index([tenantId, quotationId])
  @@map("quotation_items")
}

model SalesOrder {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String     @map("tenant_id") @db.Uuid
  tenant               Tenant     @relation(fields: [tenantId], references: [id])
  number               String?    @db.VarChar(32)
  sourceQuotationId    String?    @map("source_quotation_id") @db.Uuid
  sourceQuotation      Quotation? @relation(fields: [sourceQuotationId], references: [id])
  customerId           String     @map("customer_id") @db.Uuid
  customer             Customer   @relation(fields: [customerId], references: [id])
  branchId             String?    @map("branch_id") @db.Uuid
  branch               Branch?    @relation(fields: [branchId], references: [id])
  status               String     @default("DRAFT") @db.VarChar(16)
  currency             String     @default("USD") @db.VarChar(3)
  expectedDeliveryDate DateTime?  @map("expected_delivery_date") @db.Timestamptz(6)
  subtotal             Decimal    @default(0) @db.Decimal(18, 4)
  discountTotal        Decimal    @default(0) @map("discount_total") @db.Decimal(18, 4)
  taxTotal             Decimal    @default(0) @map("tax_total") @db.Decimal(18, 4)
  total                Decimal    @default(0) @db.Decimal(18, 4)
  notes                String?    @db.Text
  createdById          String?    @map("created_by_id") @db.Uuid
  approvedById         String?    @map("approved_by_id") @db.Uuid
  approvedAt           DateTime?  @map("approved_at") @db.Timestamptz(6)
  mobileUuid           String?    @unique @map("mobile_uuid") @db.Uuid
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  items      SalesOrderItem[]
  deliveries Delivery[]
  invoices   Invoice[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  salesOrderId String     @map("sales_order_id") @db.Uuid
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String?    @map("product_id") @db.Uuid
  product      Product?   @relation(fields: [productId], references: [id])
  description  String     @db.Text
  quantity     Decimal    @db.Decimal(18, 4)
  unitId       String?    @map("unit_id") @db.Uuid
  unit         Unit?      @relation(fields: [unitId], references: [id])
  unitPrice    Decimal    @map("unit_price") @db.Decimal(18, 4)
  discountPct  Decimal    @default(0) @map("discount_pct") @db.Decimal(5, 2)
  discountAmt  Decimal    @default(0) @map("discount_amt") @db.Decimal(18, 4)
  taxRateId    String?    @map("tax_rate_id") @db.Uuid
  taxRate      TaxRate?   @relation(fields: [taxRateId], references: [id])
  taxAmount    Decimal    @default(0) @map("tax_amount") @db.Decimal(18, 4)
  lineTotal    Decimal    @default(0) @map("line_total") @db.Decimal(18, 4)
  deliveredQty Decimal    @default(0) @map("delivered_quantity") @db.Decimal(18, 4)
  sortOrder    Int        @default(0) @map("sort_order")

  @@index([tenantId, salesOrderId])
  @@map("sales_order_items")
}

model Delivery {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  number       String?    @db.VarChar(32)
  salesOrderId String     @map("sales_order_id") @db.Uuid
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  warehouseId  String?    @map("warehouse_id") @db.Uuid
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id])
  deliveryDate DateTime?  @map("delivery_date") @db.Timestamptz(6)
  status       String     @default("DRAFT") @db.VarChar(16)
  notes        String?    @db.Text
  createdById  String?    @map("created_by_id") @db.Uuid
  postedById   String?    @map("posted_by_id") @db.Uuid
  postedAt     DateTime?  @map("posted_at") @db.Timestamptz(6)
  mobileUuid   String?    @unique @map("mobile_uuid") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  items          DeliveryItem[]
  tenantInvoices Invoice[]      @relation("DeliveryInvoices")

  @@unique([tenantId, number])
  @@index([tenantId, salesOrderId])
  @@map("deliveries")
}

model DeliveryItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  deliveryId  String   @map("delivery_id") @db.Uuid
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  productId   String?  @map("product_id") @db.Uuid
  product     Product? @relation(fields: [productId], references: [id])
  description String   @db.Text
  quantity    Decimal  @db.Decimal(18, 4)
  unitId      String?  @map("unit_id") @db.Uuid
  unit        Unit?    @relation(fields: [unitId], references: [id])
  sortOrder   Int      @default(0) @map("sort_order")

  @@index([tenantId, deliveryId])
  @@map("delivery_items")
}

model Invoice {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  number        String?     @db.VarChar(32)
  customerId    String      @map("customer_id") @db.Uuid
  customer      Customer    @relation(fields: [customerId], references: [id])
  salesOrderId  String?     @map("sales_order_id") @db.Uuid
  salesOrder    SalesOrder? @relation(fields: [salesOrderId], references: [id])
  deliveryId    String?     @map("delivery_id") @db.Uuid
  delivery      Delivery?   @relation("DeliveryInvoices", fields: [deliveryId], references: [id])
  status        String      @default("DRAFT") @db.VarChar(16)
  currency      String      @default("USD") @db.VarChar(3)
  issueDate     DateTime    @map("issue_date") @db.Timestamptz(6)
  dueDate       DateTime?   @map("due_date") @db.Timestamptz(6)
  subtotal      Decimal     @default(0) @db.Decimal(18, 4)
  discountTotal Decimal     @default(0) @map("discount_total") @db.Decimal(18, 4)
  taxTotal      Decimal     @default(0) @map("tax_total") @db.Decimal(18, 4)
  total         Decimal     @default(0) @db.Decimal(18, 4)
  paidAmount    Decimal     @default(0) @map("paid_amount") @db.Decimal(18, 4)
  balance       Decimal     @default(0) @db.Decimal(18, 4)
  notes         String?     @db.Text
  createdById   String?     @map("created_by_id") @db.Uuid
  approvedById  String?     @map("approved_by_id") @db.Uuid
  approvedAt    DateTime?   @map("approved_at") @db.Timestamptz(6)
  mobileUuid    String?     @unique @map("mobile_uuid") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  items       InvoiceItem[]
  allocations PaymentAllocation[]

  @@unique([tenantId, number])
  @@index([tenantId, customerId, status])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  invoiceId   String   @map("invoice_id") @db.Uuid
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?  @map("product_id") @db.Uuid
  product     Product? @relation(fields: [productId], references: [id])
  description String   @db.Text
  quantity    Decimal  @db.Decimal(18, 4)
  unitId      String?  @map("unit_id") @db.Uuid
  unit        Unit?    @relation(fields: [unitId], references: [id])
  unitPrice   Decimal  @map("unit_price") @db.Decimal(18, 4)
  discountPct Decimal  @default(0) @map("discount_pct") @db.Decimal(5, 2)
  discountAmt Decimal  @default(0) @map("discount_amt") @db.Decimal(18, 4)
  taxRateId   String?  @map("tax_rate_id") @db.Uuid
  taxRate     TaxRate? @relation(fields: [taxRateId], references: [id])
  taxAmount   Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 4)
  lineTotal   Decimal  @default(0) @map("line_total") @db.Decimal(18, 4)
  sortOrder   Int      @default(0) @map("sort_order")

  @@index([tenantId, invoiceId])
  @@map("invoice_items")
}

model Payment {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  number        String?      @db.VarChar(32) // assigned at capture (G-1)
  customerId    String       @map("customer_id") @db.Uuid
  customer      Customer     @relation(fields: [customerId], references: [id])
  bankAccountId String?      @map("bank_account_id") @db.Uuid
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  amount        Decimal      @db.Decimal(18, 4)
  method        String       @db.VarChar(20) // CASH|BANK_TRANSFER|CARD|CHEQUE|OTHER
  reference     String?      @db.VarChar(64)
  status        String       @default("PENDING") @db.VarChar(16) // PENDING|CAPTURED|FAILED|VOID
  paidAt        DateTime?    @map("paid_at") @db.Timestamptz(6)
  createdById   String?      @map("created_by_id") @db.Uuid
  mobileUuid    String?      @unique @map("mobile_uuid") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  allocations PaymentAllocation[]

  @@unique([tenantId, number])
  @@index([tenantId, customerId, status])
  @@map("payments")
}

model PaymentAllocation {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  paymentId String  @map("payment_id") @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String  @map("invoice_id") @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  amount    Decimal @db.Decimal(18, 4)

  @@index([tenantId, invoiceId])
  @@map("payment_allocations")
}

model BankAccount {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  name           String   @db.VarChar(255)
  accountNumber  String?  @map("account_number") @db.VarChar(64)
  accountName    String?  @map("account_name") @db.VarChar(255)
  accountId      String?  @map("account_id") @db.Uuid // Phase 5: GL account debited on capture
  account        Account? @relation(fields: [accountId], references: [id])
  currency       String   @default("USD") @db.VarChar(3)
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(18, 4)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payments         Payment[]
  bankTransactions BankTransaction[]

  @@index([tenantId])
  @@map("bank_accounts")
}

// ---------------------------------------------------------------------------
// Inventory (minimal for Phase 3) — warehouses + stock ledger (§4.1).
// Stock is derived from movements; on-hand lives on stock_balances.
// ---------------------------------------------------------------------------

model Warehouse {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  branchId  String?  @map("branch_id") @db.Uuid
  branch    Branch?  @relation(fields: [branchId], references: [id])
  code      String   @db.VarChar(32)
  name      String   @db.VarChar(255)
  address   Json?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  deliveries     Delivery[]
  stockBalances  StockBalance[]
  stockMovements StockMovement[]

  @@unique([tenantId, code])
  @@map("warehouses")
}

model StockBalance {
  warehouseId String    @map("warehouse_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Decimal   @default(0) @db.Decimal(18, 6)
  reservedQty Decimal   @default(0) @map("reserved_quantity") @db.Decimal(18, 6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([warehouseId, productId])
  @@index([tenantId, productId])
  @@map("stock_balances")
}

model StockMovement {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  productId     String    @map("product_id") @db.Uuid
  product       Product   @relation(fields: [productId], references: [id])
  warehouseId   String    @map("warehouse_id") @db.Uuid
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  quantity      Decimal   @db.Decimal(18, 6) // signed
  type          String    @db.VarChar(16) // PURCHASE|SALE|TRANSFER_IN|TRANSFER_OUT|ADJUSTMENT|RETURN|DAMAGE|STOCKTAKE
  referenceType String?   @map("reference_type") @db.VarChar(32)
  referenceId   String?   @map("reference_id") @db.Uuid
  reason        String?   @db.Text
  unitCost      Decimal?  @map("unit_cost") @db.Decimal(18, 4)
  balanceAfter  Decimal   @map("balance_after") @db.Decimal(18, 6)
  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, productId, warehouseId, createdAt])
  @@index([tenantId, referenceType, referenceId])
  @@map("stock_movements")
}

model Batch {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  productId         String    @map("product_id") @db.Uuid
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNo           String    @map("batch_no") @db.VarChar(64)
  expiryDate        DateTime? @map("expiry_date") @db.Timestamptz(6)
  manufacturedDate  DateTime? @map("manufactured_date") @db.Timestamptz(6)
  quantityRemaining Decimal   @default(0) @map("quantity_remaining") @db.Decimal(18, 6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  serials SerialNumber[]

  @@unique([tenantId, productId, batchNo])
  @@map("batches")
}

model SerialNumber {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchId   String?  @map("batch_id") @db.Uuid
  batch     Batch?   @relation(fields: [batchId], references: [id])
  serialNo  String   @map("serial_no") @db.VarChar(64)
  status    String   @default("IN_STOCK") // IN_STOCK|SOLD|RETURNED|SCRAPPED
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, productId, serialNo])
  @@map("serial_numbers")
}

// ---------------------------------------------------------------------------
// Tenant settings (plan §6)
// ---------------------------------------------------------------------------

model TenantSetting {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String   @db.VarChar(64)
  value     String?  @db.VarChar(255)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, key])
  @@map("tenant_settings")
}

// ---------------------------------------------------------------------------
// Document files (plan §23 / G-2) — immutable generated documents.
// ---------------------------------------------------------------------------

model DocumentFile {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  documentType  String   @map("document_type") @db.VarChar(32) // INVOICE, PAYSLIP, PO...
  documentId    String   @map("document_id") @db.Uuid
  version       Int      @default(1)
  status        String   @default("PENDING") // PENDING|GENERATED|FAILED
  storageKey    String?  @map("storage_key") @db.VarChar(500)
  checksum      String?  @db.VarChar(64)
  mimeType      String?  @map("mime_type") @db.VarChar(64)
  generatedById String?  @map("generated_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, documentType, documentId, version])
  @@index([tenantId, documentType, documentId])
  @@map("document_files")
}

// ---------------------------------------------------------------------------
// SaaS (plan §28 / §9) — reserved for Phase 9, modelled now for stability.
// ---------------------------------------------------------------------------

model Subscription {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  plan      String    @db.VarChar(50)
  status    String    @default("ACTIVE")
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, plan])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Finance — Phase 5 (plan §15). Double entry, immutable after posting,
// reversals only. Ledger balances are derived from journal lines, never
// stored. Raw report SQL documented in apps/api/sql/finance.sql.
// ---------------------------------------------------------------------------

model AccountGroup {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  parentId  String?        @map("parent_id") @db.Uuid
  parent    AccountGroup?  @relation("AccountGroupTree", fields: [parentId], references: [id])
  children  AccountGroup[] @relation("AccountGroupTree")
  name      String         @db.VarChar(100)
  code      String         @db.VarChar(32)
  type      String         @db.VarChar(16) // ASSET|LIABILITY|EQUITY|REVENUE|EXPENSE
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts Account[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@map("account_groups")
}

model Account {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  accountGroupId String       @map("account_group_id") @db.Uuid
  accountGroup   AccountGroup @relation(fields: [accountGroupId], references: [id])
  code           String       @db.VarChar(32)
  name           String       @db.VarChar(255)
  type           String       @db.VarChar(16) // same enum as group — normalized here for reports
  isActive       Boolean      @default(true) @map("is_active")
  isSystem       Boolean      @default(false) @map("is_system") // COA seed rows — protected
  openingDebit   Decimal      @default(0) @map("opening_debit") @db.Decimal(18, 4)
  openingCredit  Decimal      @default(0) @map("opening_credit") @db.Decimal(18, 4)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  journalLines JournalEntryLine[]
  bankAccounts BankAccount[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@map("accounts")
}

model JournalEntry {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  number         String?        @db.VarChar(32) // JE-YYYY-NNNNNN (G-1), assigned at post
  fiscalPeriodId String?        @map("fiscal_period_id") @db.Uuid
  fiscalPeriod   FiscalPeriod?  @relation(fields: [fiscalPeriodId], references: [id])
  entryDate      DateTime       @map("entry_date") @db.Timestamptz(6)
  referenceType  String?        @map("reference_type") @db.VarChar(32) // INVOICE, PAYMENT, BILL...
  referenceId    String?        @map("reference_id") @db.Uuid
  description    String?        @db.Text
  totalDebit     Decimal        @map("total_debit") @db.Decimal(18, 4)
  totalCredit    Decimal        @map("total_credit") @db.Decimal(18, 4)
  status         String         @default("POSTED") @db.VarChar(16) // DRAFT|POSTED|REVERSED
  reversedById   String?        @map("reversed_by_id") @db.Uuid
  reversedBy     JournalEntry?  @relation("JournalReversal", fields: [reversedById], references: [id])
  reversals      JournalEntry[] @relation("JournalReversal")
  createdById    String?        @map("created_by_id") @db.Uuid
  postedAt       DateTime?      @map("posted_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  lines            JournalEntryLine[]
  bankTransactions BankTransaction[]

  @@unique([tenantId, number])
  @@index([tenantId, entryDate])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  journalEntryId String       @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String       @map("account_id") @db.Uuid
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0) @db.Decimal(18, 4)
  credit         Decimal      @default(0) @db.Decimal(18, 4)
  narration      String?      @db.Text
  reconciled     Boolean      @default(false)

  @@index([tenantId, accountId, journalEntryId])
  @@map("journal_entry_lines")
}

model FiscalPeriod {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String   @db.VarChar(50)
  startDate DateTime @map("start_date") @db.Timestamptz(6)
  endDate   DateTime @map("end_date") @db.Timestamptz(6)
  status    String   @default("OPEN") // OPEN|CLOSED|LOCKED
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  journalEntries JournalEntry[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("fiscal_periods")
}

model BankTransaction {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  bankAccountId  String        @map("bank_account_id") @db.Uuid
  bankAccount    BankAccount   @relation(fields: [bankAccountId], references: [id])
  entryDate      DateTime      @map("entry_date") @db.Timestamptz(6)
  amount         Decimal       @db.Decimal(18, 4)
  description    String?       @db.Text
  reference      String?       @db.VarChar(64)
  status         String        @default("UNRECONCILED") // UNRECONCILED|RECONCILED|MATCHED
  journalEntryId String?       @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, bankAccountId, entryDate])
  @@index([tenantId, status])
  @@map("bank_transactions")
}
