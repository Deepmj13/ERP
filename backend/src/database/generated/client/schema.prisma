  @@map("invoice_items")
}

model Payment {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  number        String?      @db.VarChar(32) // assigned at capture (G-1)
  customerId    String       @map("customer_id") @db.Uuid
  customer      Customer     @relation(fields: [customerId], references: [id])
  bankAccountId String?      @map("bank_account_id") @db.Uuid
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  amount        Decimal      @db.Decimal(18, 4)
  method        String       @db.VarChar(20) // CASH|BANK_TRANSFER|CARD|CHEQUE|OTHER
  reference     String?      @db.VarChar(64)
  status        String       @default("PENDING") @db.VarChar(16) // PENDING|CAPTURED|FAILED|VOID
  paidAt        DateTime?    @map("paid_at") @db.Timestamptz(6)
