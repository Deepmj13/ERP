// ---------------------------------------------------------------------------
// Procurement — Phase 6 (plan §27 Phase 6). Request → order → GRN → bill → payment.
// Stock-in posts PURCHASE movements via StockLedgerService; bill + payment post
// AP entries through FinanceService. Numbers assigned at post/approve (G-1).
// ---------------------------------------------------------------------------

model Vendor {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  code         String?  @db.VarChar(32)
  name         String   @db.VarChar(255)
  email        String?  @db.VarChar(255)
  phone        String?  @db.VarChar(32)
  taxId        String?  @map("tax_id") @db.VarChar(64)
  currency     String   @default("USD") @db.VarChar(3)
  paymentTerms String?  @map("payment_terms") @db.VarChar(32)
  address      Json?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  purchaseOrders PurchaseOrder[]
  vendorBills    VendorBill[]
  vendorPayments VendorPayment[]

  @@index([tenantId, isActive])
  @@map("vendors")
}

model PurchaseRequest {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  number        String?   @db.VarChar(32) // assigned at approve (G-1)
  status        String    @default("DRAFT") @db.VarChar(16) // DRAFT|SUBMITTED|APPROVED|ORDERED|CANCELLED
  requestedDate DateTime? @map("requested_date") @db.Timestamptz(6)
  notes         String?   @db.Text
  createdById   String?   @map("created_by_id") @db.Uuid
  approvedById  String?   @map("approved_by_id") @db.Uuid
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(6)
  mobileUuid    String?   @unique @map("mobile_uuid") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  items  PurchaseRequestItem[]
  orders PurchaseOrder[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  purchaseRequestId String          @map("purchase_request_id") @db.Uuid
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  productId         String?         @map("product_id") @db.Uuid
  product           Product?        @relation(fields: [productId], references: [id])
  description       String          @db.Text
  quantity          Decimal         @db.Decimal(18, 4)
  unitId            String?         @map("unit_id") @db.Uuid
  unit              Unit?           @relation(fields: [unitId], references: [id])
  expectedDate      DateTime?       @map("expected_date") @db.Timestamptz(6)
  sortOrder         Int             @default(0) @map("sort_order")

  @@index([tenantId, purchaseRequestId])
  @@map("purchase_request_items")
}

model PurchaseOrder {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String           @map("tenant_id") @db.Uuid
  tenant               Tenant           @relation(fields: [tenantId], references: [id])
  number               String?          @db.VarChar(32) // assigned at approve (G-1)
  sourceRequestId      String?          @map("source_request_id") @db.Uuid
  sourceRequest        PurchaseRequest? @relation(fields: [sourceRequestId], references: [id])
  vendorId             String           @map("vendor_id") @db.Uuid
  vendor               Vendor           @relation(fields: [vendorId], references: [id])
  status               String           @default("DRAFT") @db.VarChar(16) // DRAFT|SUBMITTED|APPROVED|PARTIALLY_RECEIVED|RECEIVED|BILLED|CANCELLED
  currency             String           @default("USD") @db.VarChar(3)
  expectedDeliveryDate DateTime?        @map("expected_delivery_date") @db.Timestamptz(6)
  subtotal             Decimal          @default(0) @db.Decimal(18, 4)
  discountTotal        Decimal          @default(0) @map("discount_total") @db.Decimal(18, 4)
  taxTotal             Decimal          @default(0) @map("tax_total") @db.Decimal(18, 4)
  total                Decimal          @default(0) @db.Decimal(18, 4)
  notes                String?          @db.Text
  createdById          String?          @map("created_by_id") @db.Uuid
  approvedById         String?          @map("approved_by_id") @db.Uuid
  approvedAt           DateTime?        @map("approved_at") @db.Timestamptz(6)
  mobileUuid           String?          @unique @map("mobile_uuid") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
  vendorBills   VendorBill[]

  @@unique([tenantId, number])
  @@index([tenantId, vendorId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String?       @map("product_id") @db.Uuid
  product         Product?      @relation(fields: [productId], references: [id])
  description     String        @db.Text
  quantity        Decimal       @db.Decimal(18, 4)
  receivedQty     Decimal       @default(0) @map("received_quantity") @db.Decimal(18, 4)
  unitId          String?       @map("unit_id") @db.Uuid
  unit            Unit?         @relation(fields: [unitId], references: [id])
  unitPrice       Decimal       @map("unit_price") @db.Decimal(18, 4)
  discountPct     Decimal       @default(0) @map("discount_pct") @db.Decimal(5, 2)
  discountAmt     Decimal       @default(0) @map("discount_amt") @db.Decimal(18, 4)
  taxRateId       String?       @map("tax_rate_id") @db.Uuid
  taxRate         TaxRate?      @relation(fields: [taxRateId], references: [id])
  taxAmount       Decimal       @default(0) @map("tax_amount") @db.Decimal(18, 4)
  lineTotal       Decimal       @default(0) @map("line_total") @db.Decimal(18, 4)
  sortOrder       Int           @default(0) @map("sort_order")

  @@index([tenantId, purchaseOrderId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  number          String?       @db.VarChar(32) // assigned at post (G-1)
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  warehouseId     String?       @map("warehouse_id") @db.Uuid
  warehouse       Warehouse?    @relation(fields: [warehouseId], references: [id])
  receiptDate     DateTime?     @map("receipt_date") @db.Timestamptz(6)
  status          String        @default("DRAFT") @db.VarChar(16) // DRAFT|RECEIVED|CANCELLED
  notes           String?       @db.Text
  createdById     String?       @map("created_by_id") @db.Uuid
  postedById      String?       @map("posted_by_id") @db.Uuid
  postedAt        DateTime?     @map("posted_at") @db.Timestamptz(6)
  mobileUuid      String?       @unique @map("mobile_uuid") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  items       GoodsReceiptItem[]
  vendorBills VendorBill[]

  @@unique([tenantId, number])
  @@index([tenantId, purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  goodsReceiptId String       @map("goods_receipt_id") @db.Uuid
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  productId      String?      @map("product_id") @db.Uuid
  product        Product?     @relation(fields: [productId], references: [id])
  description    String       @db.Text
  quantity       Decimal      @db.Decimal(18, 4)
  unitId         String?      @map("unit_id") @db.Uuid
  unit           Unit?        @relation(fields: [unitId], references: [id])
  unitCost       Decimal?     @map("unit_cost") @db.Decimal(18, 4)
  sortOrder      Int          @default(0) @map("sort_order")

  @@index([tenantId, goodsReceiptId])
  @@map("goods_receipt_items")
}

model VendorBill {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  number          String?        @db.VarChar(32) // assigned at post (G-1, gapless)
  vendorId        String         @map("vendor_id") @db.Uuid
  vendor          Vendor         @relation(fields: [vendorId], references: [id])
  purchaseOrderId String?        @map("purchase_order_id") @db.Uuid
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  goodsReceiptId  String?        @map("goods_receipt_id") @db.Uuid
  goodsReceipt    GoodsReceipt?  @relation(fields: [goodsReceiptId], references: [id])
  status          String         @default("DRAFT") @db.VarChar(16) // DRAFT|SUBMITTED|APPROVED|POSTED|PARTIALLY_PAID|PAID|CANCELLED
  currency        String         @default("USD") @db.VarChar(3)
  issueDate       DateTime       @map("issue_date") @db.Timestamptz(6)
  dueDate         DateTime?      @map("due_date") @db.Timestamptz(6)
  subtotal        Decimal        @default(0) @db.Decimal(18, 4)
  discountTotal   Decimal        @default(0) @map("discount_total") @db.Decimal(18, 4)
  taxTotal        Decimal        @default(0) @map("tax_total") @db.Decimal(18, 4)
  total           Decimal        @default(0) @db.Decimal(18, 4)
  paidAmount      Decimal        @default(0) @map("paid_amount") @db.Decimal(18, 4)
  balance         Decimal        @default(0) @db.Decimal(18, 4)
  notes           String?        @db.Text
  createdById     String?        @map("created_by_id") @db.Uuid
  approvedById    String?        @map("approved_by_id") @db.Uuid
  approvedAt      DateTime?      @map("approved_at") @db.Timestamptz(6)
  mobileUuid      String?        @unique @map("mobile_uuid") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  items       VendorBillItem[]
  allocations VendorPaymentAllocation[]

  @@unique([tenantId, number])
  @@index([tenantId, vendorId, status])
  @@map("vendor_bills")
}

model VendorBillItem {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  vendorBillId String     @map("vendor_bill_id") @db.Uuid
  vendorBill   VendorBill @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  productId    String?    @map("product_id") @db.Uuid
  product      Product?   @relation(fields: [productId], references: [id])
  description  String     @db.Text
  quantity     Decimal    @db.Decimal(18, 4)
  unitId       String?    @map("unit_id") @db.Uuid
  unit         Unit?      @relation(fields: [unitId], references: [id])
  unitPrice    Decimal    @map("unit_price") @db.Decimal(18, 4)
  discountPct  Decimal    @default(0) @map("discount_pct") @db.Decimal(5, 2)
  discountAmt  Decimal    @default(0) @map("discount_amt") @db.Decimal(18, 4)
  taxRateId    String?    @map("tax_rate_id") @db.Uuid
  taxRate      TaxRate?   @relation(fields: [taxRateId], references: [id])
  taxAmount    Decimal    @default(0) @map("tax_amount") @db.Decimal(18, 4)
  lineTotal    Decimal    @default(0) @map("line_total") @db.Decimal(18, 4)
  accountId    String?    @map("account_id") @db.Uuid
  account      Account?   @relation(fields: [accountId], references: [id])
  sortOrder    Int        @default(0) @map("sort_order")

  @@index([tenantId, vendorBillId])
  @@map("vendor_bill_items")
}

model VendorPayment {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  number        String?      @db.VarChar(32) // assigned at capture (G-1, gapless)
  vendorId      String       @map("vendor_id") @db.Uuid
  vendor        Vendor       @relation(fields: [vendorId], references: [id])
  bankAccountId String?      @map("bank_account_id") @db.Uuid
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  amount        Decimal      @db.Decimal(18, 4)
  method        String       @db.VarChar(20) // CASH|BANK_TRANSFER|CARD|CHEQUE|OTHER
  reference     String?      @db.VarChar(64)
  status        String       @default("PENDING") @db.VarChar(16) // PENDING|CAPTURED|FAILED|VOID
  paidAt        DateTime?    @map("paid_at") @db.Timestamptz(6)
  createdById   String?      @map("created_by_id") @db.Uuid
  mobileUuid    String?      @unique @map("mobile_uuid") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  allocations VendorPaymentAllocation[]

  @@unique([tenantId, number])
  @@index([tenantId, vendorId, status])
  @@map("vendor_payments")
}

model VendorPaymentAllocation {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  vendorPaymentId String        @map("vendor_payment_id") @db.Uuid
  vendorPayment   VendorPayment @relation(fields: [vendorPaymentId], references: [id], onDelete: Cascade)
  vendorBillId    String        @map("vendor_bill_id") @db.Uuid
  vendorBill      VendorBill    @relation(fields: [vendorBillId], references: [id])
  amount          Decimal       @db.Decimal(18, 4)

  @@index([tenantId, vendorBillId])
  @@map("vendor_payment_allocations")
}

// ---------------------------------------------------------------------------
// Phase 7a — HR Master (plan §27 Phase 7a): departments, employee roster,
// attendance, leave types + leave cycle. User (identity) stays separate from
// Employee; `approved_by_id` / `user_id` are plain scalars (identity refs).
// ---------------------------------------------------------------------------

model Department {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  parentId  String?  @map("parent_id") @db.Uuid
  code      String   @db.VarChar(32)
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employees Employee[]

  @@unique([tenantId, code])
  @@index([tenantId, parentId])
  @@map("departments")
}

model Employee {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  userId       String?     @map("user_id") @db.Uuid // optional link to a login (Self-service HR later)
  user         User?       @relation(fields: [userId], references: [id])
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])
  employeeNo   String      @map("employee_no") @db.VarChar(32)
  firstName    String      @map("first_name") @db.VarChar(100)
  lastName     String      @map("last_name") @db.VarChar(100)
  jobTitle     String?     @map("job_title") @db.VarChar(100)
  joinDate     DateTime?   @map("join_date") @db.Timestamptz(6)
  status       String      @default("ACTIVE") @db.VarChar(20) // ACTIVE|ON_LEAVE|TERMINATED
  email        String?     @db.VarChar(255)
  phone        String?     @db.VarChar(32)
  address      Json?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  attendance       Attendance[]
  leaves           Leave[]
  salaryStructures SalaryStructure[]
  payslips         Payslip[]

  @@unique([tenantId, employeeNo])
  @@index([tenantId, departmentId])
  @@map("employees")
}

model Attendance {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  employeeId String    @map("employee_id") @db.Uuid
  employee   Employee  @relation(fields: [employeeId], references: [id])
  workDate   DateTime  @map("work_date") @db.Timestamptz(6)
  checkIn    DateTime? @map("check_in") @db.Timestamptz(6)
  checkOut   DateTime? @map("check_out") @db.Timestamptz(6)
  status     String    @default("PRESENT") @db.VarChar(16) // PRESENT|ABSENT|LATE|HALF_DAY
  mobileUuid String?   @unique @map("mobile_uuid") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, employeeId, workDate])
  @@index([tenantId, workDate])
  @@map("attendance")
}

model LeaveType {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  code            String   @db.VarChar(32)
  name            String   @db.VarChar(100)
  entitlementDays Decimal  @default(0) @map("entitlement_days") @db.Decimal(6, 1) // annual
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  leaves Leave[]

  @@unique([tenantId, code])
  @@map("leave_types")
}

model Leave {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  employeeId   String    @map("employee_id") @db.Uuid
  employee     Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId  String    @map("leave_type_id") @db.Uuid
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id])
  startDate    DateTime  @map("start_date") @db.Timestamptz(6)
  endDate      DateTime  @map("end_date") @db.Timestamptz(6)
  days         Decimal   @db.Decimal(6, 1)
  reason       String?   @db.Text
  status       String    @default("PENDING") @db.VarChar(16) // PENDING|APPROVED|REJECTED|CANCELLED
  approvedById String?   @map("approved_by_id") @db.Uuid
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)
  mobileUuid   String?   @unique @map("mobile_uuid") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, employeeId])
  @@map("leaves")
}

// ---------------------------------------------------------------------------
// Phase 7b — Payroll (plan §27 Phase 7b): flat salary structures, monthly
// payroll runs computed → approved → posted → reversed, and per-employee
// payslips. Reversal discipline (rule 6): documents are immutable; the run
// number (PR-YYYY-MM) stays stable and the reversing journal entry carries
// the reversal semantics. Payslip PDFs live in document_files (the source of
// truth) — no worker→payslip coupling.
// ---------------------------------------------------------------------------

model SalaryStructure {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  employeeId        String   @map("employee_id") @db.Uuid
  employee          Employee @relation(fields: [employeeId], references: [id])
  effectiveDate     DateTime @map("effective_date") @db.Timestamptz(6)
  currency          String   @default("USD") @db.VarChar(3)
  basicSalary       Decimal  @map("basic_salary") @db.Decimal(18, 4)
  allowances        Json     @default("{}") // { "housing": {...}, "transport": {...} }
  deductions        Json     @default("{}") // { "tax": {...}, "insurance": {...} }
  payStructureNotes String?  @map("pay_structure_notes") @db.Text
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, employeeId, effectiveDate])
  @@index([tenantId, employeeId, isActive])
  @@map("salary_structures")
}

model PayrollRun {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  number          String    @map("number") @db.VarChar(32) // PR-YYYY-MM — derived from periodStart (UTC), immutable
  periodStart     DateTime  @map("period_start") @db.Timestamptz(6)
  periodEnd       DateTime  @map("period_end") @db.Timestamptz(6)
  status          String    @default("DRAFT") @db.VarChar(16) // DRAFT|APPROVED|POSTED|REVERSED
  approvedById    String?   @map("approved_by_id") @db.Uuid
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(6)
  postedById      String?   @map("posted_by_id") @db.Uuid
  postedAt        DateTime? @map("posted_at") @db.Timestamptz(6)
  totalGross      Decimal   @default(0) @map("total_gross") @db.Decimal(18, 4)
  totalDeductions Decimal   @default(0) @map("total_deductions") @db.Decimal(18, 4)
  totalNet        Decimal   @default(0) @map("total_net") @db.Decimal(18, 4)
  reversedById    String?   @map("reversed_by_id") @db.Uuid
  reversedAt      DateTime? @map("reversed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  payslips Payslip[]

  @@unique([tenantId, number])
  @@unique([tenantId, periodStart, periodEnd])
  @@index([tenantId, status])
  @@map("payroll_runs")
}

model Payslip {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  payrollRunId    String     @map("payroll_run_id") @db.Uuid
  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId      String     @map("employee_id") @db.Uuid
  employee        Employee   @relation(fields: [employeeId], references: [id])
  grossPay        Decimal    @map("gross_pay") @db.Decimal(18, 4)
  totalDeductions Decimal    @map("total_deductions") @db.Decimal(18, 4)
  netPay          Decimal    @map("net_pay") @db.Decimal(18, 4)
  earnings        Json
  deductions      Json
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, payrollRunId])
  @@index([tenantId, employeeId])
  @@map("payslips")
}

// ---------------------------------------------------------------------------
// Phase 8 — Operations (plan §27 Phase 8 / future.md): projects, tasks, the
// generic approvals primitive, and the notification inbox. The approvals and
// notifications primitives here are reused by every earlier phase's state
// machine. All tables are tenant-owned → RLS ENABLE + FORCE (ADR-0002).
// ---------------------------------------------------------------------------

model Project {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  customerId String?   @map("customer_id") @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id])
  code       String    @db.VarChar(32)
  name       String    @db.VarChar(255)
  status     String    @default("ACTIVE") @db.VarChar(16) // ACTIVE|ON_HOLD|COMPLETED|CANCELLED
  startDate  DateTime? @map("start_date") @db.Timestamptz(6)
  endDate    DateTime? @map("end_date") @db.Timestamptz(6)
  budget     Decimal?  @db.Decimal(18, 4)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tasks ProjectTask[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@map("projects")
}

model ProjectTask {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  projectId   String    @map("project_id") @db.Uuid
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId  String?   @map("assignee_id") @db.Uuid // user (no relation: users are platform-wide)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  status      String    @default("TODO") @db.VarChar(16) // TODO|IN_PROGRESS|IN_REVIEW|DONE|CANCELLED
  priority    String    @default("MEDIUM") @db.VarChar(16) // LOW|MEDIUM|HIGH|URGENT
  dueDate     DateTime? @map("due_date") @db.Timestamptz(6)
  mobileUuid  String?   @unique @map("mobile_uuid") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, projectId])
  @@index([tenantId, assigneeId, status])
  @@map("project_tasks")
}

model ApprovalRequest {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  objectType    String    @map("object_type") @db.VarChar(32) // QUOTATION|PURCHASE_ORDER|LEAVE|PAYROLL_RUN...
  objectId      String    @map("object_id") @db.Uuid
  objectNumber  String?   @map("object_number") @db.VarChar(32)
  requestedById String    @map("requested_by_id") @db.Uuid
  approverId    String?   @map("approver_id") @db.Uuid // assigned approver (routing)
  status        String    @default("PENDING") @db.VarChar(16) // PENDING|APPROVED|REJECTED|CANCELLED
  comment       String?   @db.Text // last decision comment
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, objectType, objectId])
  @@index([tenantId, approverId, status])
  @@map("approval_requests")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  userId    String    @map("user_id") @db.Uuid // recipient (user, no relation)
  type      String    @db.VarChar(50) // invoice.posted, low.stock, leave.approved...
  title     String    @db.VarChar(255)
  body      String?   @db.Text
  channel   String    @default("IN_APP") @db.VarChar(16) // IN_APP|EMAIL|PUSH
  data      Json?
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

model NotificationPreference {
  tenantId   String  @map("tenant_id") @db.Uuid
  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  userId     String  @map("user_id") @db.Uuid // user, no relation
  channel    String  @db.VarChar(16) // EMAIL|PUSH|IN_APP
  enabled    Boolean @default(true)
  quietStart String? @map("quiet_start") @db.VarChar(5) // "22:00"
  quietEnd   String? @map("quiet_end") @db.VarChar(5)

  @@id([userId, channel])
  @@index([tenantId])
  @@map("notification_preferences")
}
