// Multi-tenant ERP — platform foundation schema
// Conventions (plan §11): UUID PKs, tenant_id on every owned table,
// created_at/updated_at TIMESTAMPTZ, constraint-heavy.
// RLS policies are applied as raw SQL migration steps (not expressible in schema).

generator client {
  provider = "prisma-client-js"
  output   = "../src/database/generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Prisma CLI/migrations use the direct Neon endpoint; runtime uses the pooler.
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  INACTIVE
}

// Keep portable for the sSaaS scale-out path (plan §7): strongly typed
// tenant_id filters, UUID keys everywhere.
model Tenant {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String       @unique @db.VarChar(63)
  status    TenantStatus @default(TRIAL)
  timezone  String       @default("UTC") @db.VarChar(64)
  currency  String       @default("USD") @db.VarChar(3)
  country   String?      @db.VarChar(2)
  language  String       @default("en") @db.VarChar(8)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  users             TenantUser[]
  roles             Role[]
  permissions       RolePermission[]
  userRoles         UserRole[]
  sessions          Session[]
  auditLogs         AuditLog[]
  sequences         DocumentSequence[]
  subscriptions     Subscription[]
  usageMetrics      UsageMetric[]
  billingEvents     BillingEvent[]
  idempotencyKeys   IdempotencyKey[]
  companies         Company[]
  branches          Branch[]
  tenantSettings    TenantSetting[]
  customers         Customer[]
  customerContacts  CustomerContact[]
  units             Unit[]
  productCategories ProductCategory[]
  products          Product[]
  taxRates          TaxRate[]
  documentFiles     DocumentFile[]

  quotations               Quotation[]
  quotationItems           QuotationItem[]
  salesOrders              SalesOrder[]
  salesOrderItems          SalesOrderItem[]
  deliveries               Delivery[]
  deliveryItems            DeliveryItem[]
  invoices                 Invoice[]
  invoiceItems             InvoiceItem[]
  payments                 Payment[]
  paymentAllocations       PaymentAllocation[]
  bankAccounts             BankAccount[]
  warehouses               Warehouse[]
  stockBalances            StockBalance[]
  stockMovements           StockMovement[]
  batches                  Batch[]
  serials                  SerialNumber[]
  accountGroups            AccountGroup[]
  accounts                 Account[]
  journalEntries           JournalEntry[]
  journalEntryLines        JournalEntryLine[]
  fiscalPeriods            FiscalPeriod[]
  bankTransactions         BankTransaction[]
  vendors                  Vendor[]
  purchaseRequests         PurchaseRequest[]
  purchaseRequestItems     PurchaseRequestItem[]
  purchaseOrders           PurchaseOrder[]
  purchaseOrderItems       PurchaseOrderItem[]
  goodsReceipts            GoodsReceipt[]
  goodsReceiptItems        GoodsReceiptItem[]
  vendorBills              VendorBill[]
  vendorBillItems          VendorBillItem[]
  vendorPayments           VendorPayment[]
  vendorPaymentAllocations VendorPaymentAllocation[]
  departments              Department[]
  employees                Employee[]
  attendance               Attendance[]
  leaveTypes               LeaveType[]
  leaves                   Leave[]
  salaryStructures         SalaryStructure[]
  payrollRuns              PayrollRun[]
  payslips                 Payslip[]
  projects                 Project[]
  projectTasks             ProjectTask[]
  approvalRequests         ApprovalRequest[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]

  @@index([status])
  @@map("tenants")
}

model TenantUser {
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @map("tenant_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id])
  userId   String @map("user_id") @db.Uuid
  status   String @default("ACTIVE")

  @@id([tenantId, userId])
  @@index([userId])
  @@map("tenant_users")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(255)
  status       String    @default("ACTIVE")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenants   TenantUser[]
  userRoles UserRole[]
  sessions  Session[]
  auditLogs AuditLog[]
  employees Employee[]

  @@index([email])
  @@map("users")
}

// ---------------------------------------------------------------------------
// RBAC (plan §9) — permission codes, tenant-scoped roles.
// ---------------------------------------------------------------------------

model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String   @db.VarChar(100)
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String @unique @db.VarChar(120) // e.g. sales.quote.approve
  description String @db.VarChar(255)
  group       String @db.VarChar(60)

  roles RolePermission[]

  @@index([group])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  tenant       Tenant     @relation(fields: [tenantId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId   String @map("user_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id])
  role     Role   @relation(fields: [roleId], references: [id])
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Sessions (plan §24) — rotated refresh tokens stored as hashes.
// ---------------------------------------------------------------------------

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model Session {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  refreshTokenHash String        @unique @map("refresh_token_hash") @db.VarChar(128)
  familyId         String        @map("family_id") @db.Uuid
  device           Json?
  status           SessionStatus @default(ACTIVE)
  lastUsedAt       DateTime?     @map("last_used_at") @db.Timestamptz(6)
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([familyId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Idempotency (plan §16a) — PG table is the source of truth for correctness.
// ---------------------------------------------------------------------------

enum IdempotencyStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

model IdempotencyKey {
  key          String            @db.VarChar(64)
  endpoint     String            @db.VarChar(255)
  userId       String            @map("user_id") @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  requestHash  String            @map("request_hash") @db.VarChar(64)
  status       IdempotencyStatus @default(PENDING)
  responseCode Int?              @map("response_code")
  responseBody Json?
  lockedAt     DateTime?         @map("locked_at") @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt   DateTime?         @map("finished_at") @db.Timestamptz(6)
  expiresAt    DateTime          @map("expires_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([key, endpoint, userId])
  @@index([tenantId])
  @@index([lockedAt, status])
  @@index([expiresAt, status])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Document numbering (plan §12) — tenant + document_type + financial_year.
// ---------------------------------------------------------------------------

model DocumentSequence {
  tenantId      String   @map("tenant_id") @db.Uuid
  documentType  String   @map("document_type") @db.VarChar(32)
  financialYear Int      @map("financial_year")
  prefix        String   @db.VarChar(20)
  nextNumber    BigInt   @default(1) @map("next_number")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, documentType, financialYear])
  @@map("document_sequences")
}

// ---------------------------------------------------------------------------
// Audit log (plan §21) — centralized backend instrumentation.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String   @map("entity_id") @db.VarChar(64)
  oldValues  Json?
  newValues  Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Organization (plan §10) — built in Phase 1 with the foundation.
// ---------------------------------------------------------------------------

model Company {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String   @db.VarChar(255)
  legalName String?  @map("legal_name") @db.VarChar(255)
  taxId     String?  @map("tax_id") @db.VarChar(64)
  email     String?  @db.VarChar(255)
  phone     String?  @db.VarChar(32)
  country   String?  @db.VarChar(2)
  currency  String   @default("USD") @db.VarChar(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branches Branch[]

  @@index([tenantId])
  @@map("companies")
}

model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(255)
  code      String?  @db.VarChar(32)
  address   Json?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  quotations  Quotation[]
  salesOrders SalesOrder[]
  warehouses  Warehouse[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// CRM — Phase 2 (plan §CRM)
// ---------------------------------------------------------------------------

model Customer {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  code     String? @db.VarChar(32)
  name     String  @db.VarChar(255)
  email    String? @db.VarChar(255)
  phone    String? @db.VarChar(32)
  website  String? @db.VarChar(255)
  taxId    String? @map("tax_id") @db.VarChar(64)
  currency String  @default("USD") @db.VarChar(3)
  address  Json?
  notes    String? @db.Text
  isActive Boolean @default(true) @map("is_active")

  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  contacts    CustomerContact[]
  quotations  Quotation[]
  salesOrders SalesOrder[]
  invoices    Invoice[]
  payments    Payment[]
  projects    Project[]

  @@index([tenantId, isActive])
  @@map("customers")
}

model CustomerContact {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String   @db.VarChar(255)
  title      String?  @db.VarChar(100)
  email      String?  @db.VarChar(255)
  phone      String?  @db.VarChar(32)
  isPrimary  Boolean  @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([customerId])
  @@index([tenantId])
  @@map("customer_contacts")
}

// ---------------------------------------------------------------------------
// Master data / inventory — Phase 2 (plan §Inventory)
// ---------------------------------------------------------------------------

model Unit {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String   @db.VarChar(100)
  code         String   @db.VarChar(16)
  symbol       String?  @db.VarChar(16)
  baseUnitId   String?  @map("base_unit_id") @db.Uuid
  baseUnit     Unit?    @relation("UnitConversion", fields: [baseUnitId], references: [id])
  derivedUnits Unit[]   @relation("UnitConversion")
  factorToBase Decimal? @map("factor_to_base") @db.Decimal(18, 6)
  isActive     Boolean  @default(true) @map("is_active")

  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  products             Product[]
  quotationItems       QuotationItem[]
  salesOrderItems      SalesOrderItem[]
  deliveryItems        DeliveryItem[]
  invoiceItems         InvoiceItem[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  vendorBillItems      VendorBillItem[]

  @@unique([tenantId, code])
  @@map("units")
}

model ProductCategory {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  parentId    String?           @map("parent_id") @db.Uuid
  parent      ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("CategoryTree")
  name        String            @db.VarChar(255)
  code        String?           @db.VarChar(32)
  description String?           @db.Text
  isActive    Boolean           @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  products  Product[]

  @@index([tenantId, isActive])
  @@map("product_categories")
}

model Product {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  categoryId  String?          @map("category_id") @db.Uuid
  category    ProductCategory? @relation(fields: [categoryId], references: [id])
  unitId      String?          @map("unit_id") @db.Uuid
  unit        Unit?            @relation(fields: [unitId], references: [id])
  taxRateId   String?          @map("tax_rate_id") @db.Uuid
  taxRate     TaxRate?         @relation(fields: [taxRateId], references: [id])
  type        ProductType      @default(GOOD)
  name        String           @db.VarChar(255)
  sku         String           @db.VarChar(64)
  barcode     String?          @db.VarChar(64)
  description String?          @db.Text
  costPrice   Decimal?         @map("cost_price") @db.Decimal(18, 4)
  salePrice   Decimal?         @map("sale_price") @db.Decimal(18, 4)
  isActive    Boolean          @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  quotationItems       QuotationItem[]
  salesOrderItems      SalesOrderItem[]
  deliveryItems        DeliveryItem[]
  invoiceItems         InvoiceItem[]
  stockBalances        StockBalance[]
  stockMovements       StockMovement[]
  batches              Batch[]
  serials              SerialNumber[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  vendorBillItems      VendorBillItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, name])
  @@map("products")
}

enum ProductType {
  GOOD
  SERVICE
}

model TaxRate {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  name        String  @db.VarChar(100)
  code        String  @db.VarChar(20)
  rate        Decimal @db.Decimal(5, 2)
  isInclusive Boolean @default(false) @map("is_inclusive")
  isActive    Boolean @default(true) @map("is_active")

  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  products           Product[]
  quotationItems     QuotationItem[]
  salesOrderItems    SalesOrderItem[]
  invoiceItems       InvoiceItem[]
  purchaseOrderItems PurchaseOrderItem[]
  vendorBillItems    VendorBillItem[]

  @@unique([tenantId, code])
  @@map("tax_rates")
}

// ---------------------------------------------------------------------------
// Sales — Phase 3 (plan §13). State machines, document numbering at post.
// ---------------------------------------------------------------------------

model Quotation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  number        String?   @db.VarChar(32)
  customerId    String    @map("customer_id") @db.Uuid
  customer      Customer  @relation(fields: [customerId], references: [id])
  branchId      String?   @map("branch_id") @db.Uuid
  branch        Branch?   @relation(fields: [branchId], references: [id])
  status        String    @default("DRAFT") @db.VarChar(16)
  currency      String    @default("USD") @db.VarChar(3)
  validUntil    DateTime? @map("valid_until") @db.Timestamptz(6)
  subtotal      Decimal   @default(0) @db.Decimal(18, 4)
  discountTotal Decimal   @default(0) @map("discount_total") @db.Decimal(18, 4)
  taxTotal      Decimal   @default(0) @map("tax_total") @db.Decimal(18, 4)
  total         Decimal   @default(0) @db.Decimal(18, 4)
  notes         String?   @db.Text
  createdById   String?   @map("created_by_id") @db.Uuid
  approvedById  String?   @map("approved_by_id") @db.Uuid
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(6)
  mobileUuid    String?   @unique @map("mobile_uuid") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  items  QuotationItem[]
  orders SalesOrder[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  quotationId String    @map("quotation_id") @db.Uuid
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String?   @map("product_id") @db.Uuid
  product     Product?  @relation(fields: [productId], references: [id])
  description String    @db.Text
  quantity    Decimal   @db.Decimal(18, 4)
  unitId      String?   @map("unit_id") @db.Uuid
  unit        Unit?     @relation(fields: [unitId], references: [id])
  unitPrice   Decimal   @map("unit_price") @db.Decimal(18, 4)
  discountPct Decimal   @default(0) @map("discount_pct") @db.Decimal(5, 2)
  discountAmt Decimal   @default(0) @map("discount_amt") @db.Decimal(18, 4)
  taxRateId   String?   @map("tax_rate_id") @db.Uuid
  taxRate     TaxRate?  @relation(fields: [taxRateId], references: [id])
  taxAmount   Decimal   @default(0) @map("tax_amount") @db.Decimal(18, 4)
  lineTotal   Decimal   @default(0) @map("line_total") @db.Decimal(18, 4)
  sortOrder   Int       @default(0) @map("sort_order")

  @@index([tenantId, quotationId])
  @@map("quotation_items")
}

model SalesOrder {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String     @map("tenant_id") @db.Uuid
  tenant               Tenant     @relation(fields: [tenantId], references: [id])
  number               String?    @db.VarChar(32)
  sourceQuotationId    String?    @map("source_quotation_id") @db.Uuid
  sourceQuotation      Quotation? @relation(fields: [sourceQuotationId], references: [id])
  customerId           String     @map("customer_id") @db.Uuid
  customer             Customer   @relation(fields: [customerId], references: [id])
  branchId             String?    @map("branch_id") @db.Uuid
  branch               Branch?    @relation(fields: [branchId], references: [id])
  status               String     @default("DRAFT") @db.VarChar(16)
  currency             String     @default("USD") @db.VarChar(3)
  expectedDeliveryDate DateTime?  @map("expected_delivery_date") @db.Timestamptz(6)
  subtotal             Decimal    @default(0) @db.Decimal(18, 4)
  discountTotal        Decimal    @default(0) @map("discount_total") @db.Decimal(18, 4)
  taxTotal             Decimal    @default(0) @map("tax_total") @db.Decimal(18, 4)
  total                Decimal    @default(0) @db.Decimal(18, 4)
  notes                String?    @db.Text
  createdById          String?    @map("created_by_id") @db.Uuid
  approvedById         String?    @map("approved_by_id") @db.Uuid
  approvedAt           DateTime?  @map("approved_at") @db.Timestamptz(6)
  mobileUuid           String?    @unique @map("mobile_uuid") @db.Uuid
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
