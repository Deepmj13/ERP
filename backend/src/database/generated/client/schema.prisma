  tenantId           String    @map("tenant_id") @db.Uuid
  planCode           String    @map("plan_code") @db.VarChar(40)
  status             String    @default("ACTIVE") // ACTIVE|TRIAL|PAST_DUE|CANCELLED
  interval           String    @default("MONTHLY") @db.VarChar(16)
  currency           String    @default("USD") @db.VarChar(3)
  billingProviderRef String?   @map("billing_provider_ref") @db.VarChar(128)
  startedAt          DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endsAt             DateTime? @map("ends_at") @db.Timestamptz(6)
  trialEndsAt        DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, planCode])
  @@map("subscriptions")
}

model SubscriptionPlan {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(40) // free|starter|professional|enterprise
  name      String   @db.VarChar(80)
