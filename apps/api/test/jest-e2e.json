{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testPathIgnorePatterns": ["/node_modules/", "/dist/"],
  "testTimeout": 180000,
  "moduleNameMapper": {
    "^@erp/database$": "<rootDir>/../../database/src/index",
    "^@erp/storage$": "<rootDir>/../../packages/storage/src/index",
    "^@erp/config$": "<rootDir>/../../packages/config/src/index",
    "^@erp/shared-types$": "<rootDir>/../../packages/shared_types/src/index",
    "^@erp/api-contracts$": "<rootDir>/../../packages/api_contracts/src/index"
  }
}
